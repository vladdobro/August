# Server port.
PORT=3001

# Path to whisper binary. Auto-detected per platform if empty.
#   Windows x64:          whisper/bin/win-x64/whisper-cli.exe
#   macOS Apple Silicon:  whisper/bin/darwin-arm64/whisper-cli
#   macOS Intel:          whisper/bin/darwin-x64/whisper-cli
# Run `npm run setup` to download (Windows) or build (macOS) it.
# WHISPER_BIN_PATH=

# Path to whisper model. Auto-downloaded on first run if missing.
#   Default: whisper/models/ggml-large-v3-turbo.bin (~1.6 GB, SHA256-verified).
#   A custom path with a different file name is never auto-downloaded.
# WHISPER_MODEL_PATH=

# Whisper GPU mode. Empty = platform default (Vulkan on Windows x64, Metal on Apple Silicon, CPU elsewhere) with
# automatic CPU fallback: if whisper-cli fails with a Vulkan error the job is retried once with --no-gpu and the
# server stays on CPU until restarted. 1 forces the GPU on, 0 forces CPU; either value disables the probe and fallback.
# WHISPER_USE_GPU=

# Path to the ffmpeg executable. Resolution order when empty:
#   1. the bundled build next to whisper-cli — whisper/bin/<platform>/ffmpeg[.exe], installed by `npm run setup`
#   2. `ffmpeg` on PATH (winget / brew install) as a fallback
# ffprobe is taken from the same directory as the chosen ffmpeg (or from PATH).
# The August desktop app (Electron) points this at its bundled copy automatically.
# FFMPEG_PATH=

# Writable runtime data root (sessions, uploads, captures, preferences, perf stats). Defaults to server/data.
# The August desktop app (Electron) sets this to its user-data folder automatically; leave empty for the web app.
# AUGUST_DATA_DIR=

# Dev-only Agentation widget endpoint (client).
VITE_AGENTATION_ENDPOINT=http://127.0.0.1:4747

# Groq API key for live transcription (optional, enables cloud whisper).
# Get one at https://console.groq.com — free tier: 20 req/min.
# GROQ_API_KEY=
