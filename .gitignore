# Dependencies
node_modules/

# Build output
dist/
build/

# Environment
.env
.env.local

# Session data (file-based storage; keep the folder via .gitkeep)
server/data/sessions/*
!server/data/sessions/.gitkeep
server/data/uploads/*
!server/data/uploads/.gitkeep

# Runtime server data (machine-specific, regenerated automatically)
server/data/perf-stats.json
server/data/user-preferences.json
server/data/live-tmp/
server/data/captures/
server/data/tools/

# Legacy pre-AUG-109 preferences location; migrated to server/data/ on server start
server/src/data/user-preferences.json

# Whisper native binaries (downloaded/built by `npm run setup`; see whisper/README.md)
whisper/bin/
whisper/.build/

# Whisper model files (large, auto-downloaded on first server start)
whisper/models/*.bin
whisper/models/*.part

# Misc uploads
uploads/

# Logs
*.log
npm-debug.log*

# Editor/OS
.DS_Store
Thumbs.db
.vscode/
.idea/
.praxis/chat
.praxis/config/
.praxis/scripts
.praxis/prompts
.praxis/assets
.praxis/api
.praxis/context
.praxis/user_assets
.mcp.json
.praxis/analytics
